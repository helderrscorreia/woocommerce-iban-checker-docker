# =============================================================================
# WooCommerce IBAN Watchdog — environment template
#
# Copy to .env, fill in, then: docker compose up -d --build
# .env is gitignored. Never commit real credentials.
#
# The watchdog polls the WordPress options table, compares the BACS / offline
# bank-transfer accounts against config/expected-accounts.json, and alerts when
# IBAN, BIC, account number, sort code, or the number/order of accounts changes.
# See README.md for the threat model and known limits.
# =============================================================================

# =============================================================================
# 1. Remote database (required)
# =============================================================================
# Use a dedicated, least-privilege MySQL user.
# With AUTO_RESTORE=false:
#   CREATE USER 'iban_watchdog'@'%' IDENTIFIED BY 'strong-password';
#   GRANT SELECT ON wordpress.wp_options TO 'iban_watchdog'@'%';
# With AUTO_RESTORE=true also grant:
#   GRANT UPDATE, INSERT ON wordpress.wp_options TO 'iban_watchdog'@'%';
# Nothing else is needed — do not grant access to wp_users, orders, etc.

DB_HOST=db.example.com
DB_PORT=3306
DB_NAME=wordpress
DB_USER=iban_watchdog
DB_PASSWORD=change-me

# WordPress "$table_prefix" from wp-config.php. Examples: wp_, wp_abc123_
DB_TABLE_PREFIX=wp_

# Friendly name used in alert subjects and payloads.
# Defaults to the container hostname when empty.
SITE_NAME=shop.example.com

# If MySQL only listens on the machine running Docker (local server or SSH
# tunnel), use the host gateway and add this to docker-compose.yml:
#   extra_hosts:
#     - "host.docker.internal:host-gateway"
# then set:
# DB_HOST=host.docker.internal

# =============================================================================
# 2. What is checked
# =============================================================================

# wp_options row that holds the offline bank-transfer accounts.
# Stock WooCommerce BACS uses the default; change only for a custom gateway.
WATCH_OPTION=woocommerce_bacs_accounts

# --- Option A: IBAN-only mode (simplest) -------------------------------------
# Comma-separated IBANs, in the same order as the WooCommerce accounts.
# When set, this takes precedence over BASELINE_FILE and only IBANs are
# checked (labels, BIC, account number, sort code and country code ignored).
# Account count and order still matter. AUTO_RESTORE must remain false.
# Example: EXPECTED_IBANS=PT50000201231234567890154
EXPECTED_IBANS=

# --- Option B: full baseline file --------------------------------------------
# Read-only JSON baseline mounted by docker-compose.yml. Leave unchanged unless
# you edit the volume mapping there. Ignored when EXPECTED_IBANS is set.
BASELINE_FILE=/config/expected-accounts.json

# Directory on the Docker host that contains expected-accounts.json.
# Used by docker-compose.yml (not read by the container itself).
CONFIG_DIR=./config


# Seconds between checks. 60 is a good balance; 15 gives a smaller attack
# window at the cost of more queries.
CHECK_INTERVAL=60

# =============================================================================
# 3. Reaction to a mismatch
# =============================================================================

# true  = write the baseline back to the database, then re-read to verify.
# false = alert only (recommended until you trust the baseline). Works with a
#         read-only DB user.
# Only available with BASELINE_FILE, not EXPECTED_IBANS; the watchdog refuses
# to start if both AUTO_RESTORE=true and EXPECTED_IBANS are set.
# With true, make legitimate account changes in the baseline file first,
# otherwise the watchdog reverts them. If the site uses a persistent object
# cache, flush it after a restore so WordPress drops the old cached option.
AUTO_RESTORE=false

# =============================================================================
# 4. Webhook alerts (optional — leave WEBHOOK_URL empty to disable)
# =============================================================================
# Generic JSON POST. Works with Slack, ntfy, Gotify or a custom endpoint.
# Discord webhook URLs (discord.com / discordapp.com) are detected and get a
# formatted embed (colour, title, site, timestamp, findings) instead of JSON.
# Payload keys: service, status, site, text, detected_at, restored, findings.
# "text" is a one-line summary for chat-style receivers.
# If no webhook and no email is configured, findings only appear in
# `docker logs`.

WEBHOOK_URL=

# Include full IBAN/account numbers in alerts.
# false masks them to the last 4 characters so bank details do not end up in
# chat or email archives.
ALERT_FULL_IBAN=false

# Re-send an unchanged tamper alert after this many minutes.
# 0 = alert only when the state changes. Recovery always alerts immediately.
ALERT_REMIND_MINUTES=60

# =============================================================================
# 5. Email alerts via SMTP (optional — needs all SMTP_* and ALERT_EMAIL_TO)
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587

# starttls = port 587 (default)
# ssl      = implicit TLS, port 465
# none     = plain SMTP; only for trusted local relays
SMTP_ENCRYPTION=starttls

SMTP_USER=alerts@example.com
SMTP_PASSWORD=change-me

# From/envelope address. Some providers require it to match SMTP_USER.
SMTP_FROM=alerts@example.com

# Comma-separated recipients.
ALERT_EMAIL_TO=admin@example.com

# =============================================================================
# 6. Runtime paths (change only if you know why)
# =============================================================================

# Dedupe state: last findings hash and last alert time. Stored on a named
# volume so container restarts do not re-send the same alert.
STATE_FILE=/data/state.json

# Updated after every successful cycle. The Docker HEALTHCHECK marks the
# container unhealthy when it is older than 3 x CHECK_INTERVAL.
HEARTBEAT_FILE=/tmp/watchdog.heartbeat
